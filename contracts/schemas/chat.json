{
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "system",
              "developer",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 1048576
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 1048576
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "image_url"
                        },
                        "image_url": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "pattern": "^(https://|data:image/(png|jpeg|webp|gif);base64,)",
                              "maxLength": 8388608
                            },
                            "detail": {
                              "enum": [
                                "auto",
                                "low",
                                "high"
                              ]
                            }
                          },
                          "required": [
                            "url"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "type",
                        "image_url"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "maxItems": 128,
                "minItems": 0
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "tool_call_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "type": {
                  "const": "function"
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "arguments": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 1048576
                    }
                  },
                  "required": [
                    "name",
                    "arguments"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "type",
                "function"
              ],
              "additionalProperties": false
            },
            "maxItems": 128,
            "minItems": 1
          },
          "reasoning_content": {
            "type": "string",
            "maxLength": 1048576
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "reasoning_content"
              ]
            },
            "then": {
              "properties": {
                "role": {
                  "const": "assistant"
                }
              }
            }
          }
        ]
      },
      "maxItems": 2048,
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "function"
          },
          "function": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "minLength": 0
              },
              "parameters": {
                "type": "object"
              },
              "strict": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "parameters"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "function"
        ],
        "additionalProperties": false
      },
      "maxItems": 128,
      "minItems": 1
    },
    "stream": {
      "type": "boolean"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "max_completion_tokens": {
      "type": "integer",
      "minimum": 16,
      "maximum": 10000000
    },
    "stop": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 4,
          "minItems": 1
        }
      ]
    },
    "tool_choice": {
      "oneOf": [
        {
          "enum": [
            "auto",
            "none",
            "required"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "function"
            },
            "function": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "function"
          ],
          "additionalProperties": false
        }
      ]
    },
    "parallel_tool_calls": {
      "type": "boolean"
    },
    "response_format": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "text",
                "json_object"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "json_schema"
            },
            "json_schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096
                },
                "schema": {
                  "type": "object"
                },
                "strict": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "schema"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "json_schema"
          ],
          "additionalProperties": false
        }
      ]
    },
    "stream_options": {
      "type": "object",
      "properties": {
        "include_usage": {
          "type": "boolean"
        }
      },
      "required": [
        "include_usage"
      ],
      "additionalProperties": false
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 16,
      "maximum": 10000000
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "chat_template_kwargs": {
      "type": "object",
      "properties": {
        "enable_thinking": {
          "type": "boolean"
        }
      },
      "required": [
        "enable_thinking"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "model",
    "messages"
  ],
  "additionalProperties": false,
  "not": {
    "required": [
      "max_tokens",
      "max_completion_tokens"
    ]
  }
}
