{
  "authentication": {
    "role": "settings",
    "scheme": "cookie",
    "csrf_header": "X-CSRF-Token",
    "get_header": {
      "X-Jev-Session": "1"
    },
    "authorization_header": "forbidden",
    "same_origin": true
  },
  "endpoints": {
    "status": {
      "method": "GET",
      "path": "/admin/v1/playground"
    },
    "generate": {
      "method": "POST",
      "path": "/admin/v1/playground/completions"
    }
  },
  "enabled_default": true,
  "limits": {
    "session_rpm": {
      "default": 6,
      "minimum": 1,
      "maximum": 1000000
    },
    "instance_rpm": {
      "default": 20,
      "minimum": 1,
      "maximum": 1000000
    },
    "session_concurrency": {
      "default": 1,
      "minimum": 1,
      "maximum": 128
    },
    "instance_concurrency": {
      "default": 3,
      "minimum": 1,
      "maximum": 128
    },
    "daily_requests": {
      "default": 200,
      "minimum": 1,
      "maximum": 1000000
    },
    "input_bytes": {
      "default": 32768,
      "minimum": 1,
      "maximum": 16777216
    },
    "body_bytes": {
      "default": 262144,
      "minimum": 1,
      "maximum": 16777216
    },
    "max_messages": {
      "default": 100,
      "minimum": 1,
      "maximum": 1000
    },
    "output_tokens": {
      "default": 4096,
      "minimum": 16,
      "maximum": 10000000
    },
    "timeout_seconds": {
      "default": 120,
      "minimum": 1,
      "maximum": 600
    }
  },
  "window_seconds": 60,
  "day_timezone": "UTC",
  "side_effects": [
    "Calls decision and generation providers; may incur charges and transmit conversation data.",
    "Accepted requests consume persistent quota even on failure or cancellation."
  ],
  "concurrency_scope": "single process",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model",
      "messages",
      "stream"
    ],
    "properties": {
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "stream": {
        "const": true
      },
      "messages": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "content"
          ],
          "properties": {
            "role": {
              "enum": [
                "user",
                "assistant"
              ]
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_content": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "role": {
                "const": "user"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reasoning_content"
              ]
            }
          }
        }
      }
    }
  },
  "stream": {
    "content_type": "text/event-stream",
    "events": {
      "route": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "config_version": {
            "type": "integer",
            "minimum": 0
          },
          "decision_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "request_id",
          "model_id",
          "path",
          "config_version",
          "decision_ms"
        ]
      },
      "delta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "reasoning_content": {
            "type": "string"
          }
        },
        "required": [],
        "minProperties": 1
      },
      "done": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finish_reason": {
            "enum": [
              "stop",
              "length",
              "content_filter"
            ]
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "input_details": {
                "type": "object"
              },
              "output_details": {
                "type": "object"
              }
            },
            "required": [
              "input_tokens",
              "output_tokens"
            ]
          }
        },
        "required": [
          "finish_reason"
        ]
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "stage": {
            "enum": [
              "request",
              "routing",
              "generation"
            ]
          },
          "request_id": {
            "type": "string",
            "maxLength": 128
          },
          "upstream_status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "upstream_code": {
            "type": "string",
            "maxLength": 128
          },
          "upstream_error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "body": {},
              "truncated": {
                "type": "boolean"
              },
              "request_id": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": [
              "body",
              "truncated"
            ]
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "terminal": "Exactly one done or error; EOF without terminal is interrupted.",
    "route_timing": "Route is flushed immediately after successful planning, before provider invocation. Subsequent failures are error events, including failures before the first content delta."
  },
  "errors": {
    "playground_rate_limited": {
      "http_status": 429,
      "retry_header": "Retry-After",
      "details": [
        "limit_scope",
        "retry_after_seconds",
        "reset_at (optional)"
      ]
    },
    "playground_unavailable": {
      "http_status": 503
    },
    "request_too_large": {
      "http_status": 413
    }
  },
  "error_diagnostics": {
    "fields": {
      "code": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "retryable": {
        "type": "boolean"
      },
      "stage": {
        "enum": [
          "request",
          "routing",
          "generation"
        ]
      },
      "request_id": {
        "type": "string",
        "maxLength": 128
      },
      "upstream_status": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      },
      "upstream_code": {
        "type": "string",
        "maxLength": 128
      },
      "upstream_error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "body": {},
          "truncated": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "body",
          "truncated"
        ]
      }
    },
    "policy": "JSON and SSE errors share stable local summaries and optional upstream_error {body, truncated}. Actual upstream JSON (including JSON encoded in detail strings) or plain text is sanitized before exposure. Credentials, authentication fields and structured request echoes are redacted. Input over 64 KiB is omitted; sanitized output over 16 KiB is a truncated text excerpt. HTML is inert text. SDK diagnostics and raw requests are never exposed or persisted."
  }
}
