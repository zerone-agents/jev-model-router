{
  "provider": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "base_url": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$",
        "maxLength": 4096
      },
      "secret_ref": {
        "type": "string",
        "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/[^\\x00]+|managed:[a-f0-9]{32})$",
        "maxLength": 4096
      }
    },
    "required": [
      "id",
      "base_url",
      "secret_ref"
    ],
    "additionalProperties": false
  },
  "model": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "not": {
          "const": "auto"
        }
      },
      "provider_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "upstream_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "description": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      },
      "location": {
        "enum": [
          "local",
          "cloud"
        ]
      },
      "enabled": {
        "type": "boolean"
      },
      "capabilities": {
        "type": "object",
        "properties": {
          "context_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "tools": {
            "type": "boolean"
          },
          "images": {
            "type": "boolean"
          },
          "structured_output": {
            "type": "boolean"
          },
          "reasoning": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "description": "Verified exact combinations of reasoning controls. Omitted fields mean absent in the request, not a wildcard. Empty or omitted means no explicit reasoning controls supported.",
            "items": {
              "type": "object",
              "properties": {
                "enable_thinking": {
                  "type": "boolean"
                },
                "reasoning_effort": {
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              },
              "minProperties": 1,
              "additionalProperties": false
            }
          }
        },
        "required": [
          "context_limit",
          "tools",
          "images",
          "structured_output"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "provider_id",
      "upstream_name",
      "description",
      "location",
      "enabled",
      "capabilities"
    ],
    "additionalProperties": false
  },
  "decision": {
    "type": "object",
    "properties": {
      "base_url": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$",
        "maxLength": 4096
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "secret_ref": {
        "type": "string",
        "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/[^\\x00]+)$",
        "maxLength": 4096
      }
    },
    "required": [
      "base_url",
      "model",
      "secret_ref"
    ],
    "additionalProperties": false
  },
  "provider_write": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "base_url": {
        "type": "string",
        "pattern": "^https?://[^\\s]+$",
        "maxLength": 4096
      },
      "secret_ref": {
        "type": "string",
        "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/[^\\x00]+|managed:[a-f0-9]{32})$",
        "maxLength": 4096
      },
      "api_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "^[^\\r\\n\\x00]+$",
        "writeOnly": true,
        "description": "Write-only credential, at most 16384 UTF-8 bytes. Requires a configured encryption key. Never returned; remote CLI submission requires HTTPS (loopback HTTP allowed)."
      }
    },
    "required": [
      "id",
      "base_url"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "api_key"
        ]
      },
      {
        "required": [
          "secret_ref"
        ]
      }
    ]
  }
}
