{
  "error_mapping": {
    "invalid_request": {
      "http_status": 400,
      "exit_code": 2
    },
    "unauthorized": {
      "http_status": 401,
      "exit_code": 3
    },
    "forbidden": {
      "http_status": 403,
      "exit_code": 3
    },
    "not_found": {
      "http_status": 404,
      "exit_code": 4
    },
    "config_conflict": {
      "http_status": 409,
      "exit_code": 5
    },
    "idempotency_conflict": {
      "http_status": 409,
      "exit_code": 5
    },
    "config_missing": {
      "http_status": 503,
      "exit_code": 6
    },
    "no_candidates": {
      "http_status": 422,
      "exit_code": 6
    },
    "budget_exceeded": {
      "http_status": 422,
      "exit_code": 6
    },
    "unsupported_request": {
      "http_status": 400,
      "exit_code": 2
    },
    "invalid_decision": {
      "http_status": 502,
      "exit_code": 7
    },
    "upstream_error": {
      "http_status": 502,
      "exit_code": 7
    },
    "timeout": {
      "http_status": 504,
      "exit_code": 8
    },
    "cancelled": {
      "http_status": 499,
      "exit_code": 8
    },
    "storage_error": {
      "http_status": 503,
      "exit_code": 9
    },
    "internal_error": {
      "http_status": 500,
      "exit_code": 9
    },
    "session_limit": {
      "http_status": 429,
      "exit_code": 6
    }
  },
  "retention": {
    "idempotency_hours": 24,
    "records_days": 7
  },
  "list_defaults": {
    "default": 50,
    "maximum": 200
  },
  "idempotency": {
    "required_for_writes": true,
    "scope": "authenticated identity and key",
    "request_identity": [
      "capability_id",
      "expected_version",
      "canonical input"
    ],
    "replay_before_version_check": true,
    "success_only": true,
    "validation_failure_consumes_key": false,
    "same_key_different_request": "idempotency_conflict",
    "after_expiry": "Replay is not guaranteed; the current configuration version is checked.",
    "retry": "On an unknown write outcome, retry the identical request with the same key within the validity window. Do not automatically retry route.inspect or models.test."
  },
  "versioning": {
    "scope": "global configuration",
    "conflict": "config_conflict",
    "recovery": "Read the current resource and version, then deliberately prepare a new operation; never overwrite automatically."
  }
}
