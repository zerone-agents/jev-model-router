  {
    "id": "providers.put",
    "description": "Create or replace a provider atomically; supply exactly one of api_key (encrypted at rest) or secret_ref. Managed references must belong to this provider. No connection test is performed.",
    "role": "settings",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 4096
        },
        "secret_ref": {
          "type": "string",
          "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/[^\\x00]+|managed:[a-f0-9]{32})$",
          "maxLength": 4096
        },
        "api_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\r\\n\\x00]+$",
          "writeOnly": true,
          "description": "Write-only credential, at most 16384 UTF-8 bytes. Requires a configured encryption key. Never returned; remote CLI submission requires HTTPS (loopback HTTP allowed)."
        }
      },
      "required": [
        "id",
        "base_url"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "api_key"
          ]
        },
        {
          "required": [
            "secret_ref"
          ]
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "resource": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "base_url": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$",
              "maxLength": 4096
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:/[^\\x00]+|managed:[a-f0-9]{32})$",
              "maxLength": 4096
            }
          },
          "required": [
            "id",
            "base_url",
            "secret_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "resource"
      ],
      "additionalProperties": false
    },
    "side_effects": [
      "config_write"
    ],
    "risk": "L2",
    "availability": "implemented_when_registered",
    "examples": [
      {
        "id": "p",
        "base_url": "https://example.com/v1",
        "secret_ref": "env:PROVIDER_KEY"
      },
      {
        "id": "cloud",
        "base_url": "https://example.com/v1",
        "api_key": "example-only-credential"
      }
    ],
    "write": true
  },
