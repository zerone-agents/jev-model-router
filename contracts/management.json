            "images": {
              "type": "boolean"
            },
            "structured_output": {
              "type": "boolean"
            }
          },
          "required": [
            "context_limit",
            "tools",
            "images",
            "structured_output"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "provider_id",
        "upstream_name",
        "description",
