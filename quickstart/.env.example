# Full image reference; pin a published version for repeatable upgrades.
ROUTER_IMAGE=zeroneai/jev-model-router:latest
# Optional Huawei Cloud SWR mirror, after maintainers publish to this path:
# ROUTER_IMAGE=swr.cn-east-3.myhuaweicloud.com/zerone/jev-model-router:latest
ROUTER_BIND=127.0.0.1
ROUTER_PORT=8080
# Generate TWO different values with: openssl rand -hex 32
JEV_ROUTER_SETTINGS_TOKEN=
JEV_ROUTER_INFERENCE_TOKEN=
# Recommended: one-time master key for managed generation and decision API keys.
# Generate once with openssl rand -hex 32; keep separate backups. Never rotate
# this value by simply replacing it: existing managed keys would be unreadable.
JEV_ROUTER_ENCRYPTION_KEY=

# Optional legacy environment references; prefer CLI/API managed keys.
# Set these only if existing resources use env:PROVIDER_API_KEY or
# env:TYPESAFE_API_KEY. They are not required for managed credentials.
# PROVIDER_API_KEY=
# TYPESAFE_API_KEY=

# Public HTTPS origin for remote dashboard sessions; empty allows loopback only.
# Preserve this Host through your reverse proxy and keep its backend private.
JEV_ROUTER_DASHBOARD_ORIGIN=

# Local Jev serialized request budget; not an exact token count.
JEV_ROUTER_DECISION_MAX_BYTES=32000
