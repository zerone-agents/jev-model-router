[
  {
    "id": "shipment_lookup",
    "intent": "routine; Flash expected as a routing preference, not an answer-correctness oracle",
    "prompt": "Find the current delivery status of order ORD-41. Use get_order first, then get_shipment using the returned shipment_id. Return only JSON with order_id, shipment_id, status, delivered_at (copy the timestamp exactly).",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_order",
          "description": "Read order by order_id.",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string"
              }
            },
            "required": [
              "order_id"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_shipment",
          "description": "Read current shipment status by shipment_id.",
          "parameters": {
            "type": "object",
            "properties": {
              "shipment_id": {
                "type": "string"
              }
            },
            "required": [
              "shipment_id"
            ],
            "additionalProperties": false
          }
        }
      }
    ],
    "fixtures": [
      {
        "name": "get_order",
        "args": {
          "order_id": "ORD-41"
        },
        "data": {
          "order_id": "ORD-41",
          "shipment_id": "SHIP-92",
          "cached_status": "in_transit"
        }
      },
      {
        "name": "get_shipment",
        "args": {
          "shipment_id": "SHIP-92"
        },
        "data": {
          "shipment_id": "SHIP-92",
          "status": "delivered",
          "delivered_at": "2026-09-28T09:15:00Z"
        }
      }
    ],
    "edges": [
      [
        "get_order",
        "get_shipment"
      ]
    ],
    "expected": {
      "order_id": "ORD-41",
      "shipment_id": "SHIP-92",
      "status": "delivered",
      "delivered_at": "2026-09-28T09:15:00Z"
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "shipment_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "delivered_at": {
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "shipment_id",
        "status",
        "delivered_at"
      ],
      "additionalProperties": false
    }
  },
  {
    "id": "allocation_plan",
    "intent": "multi-step constrained decision; Max preferred under current model assumptions",
    "prompt": "Plan fulfillment of ORD-77. Read the order, then inventory for its sku and shipping policy for its region. Only warehouses arriving on or before deadline_days may supply. Available units = on_hand minus reserved. Fulfill all units at minimum shipping cost: each used warehouse charges fixed_fee plus per_unit times allocated units. Units are nonnegative integers. Break equal-cost ties by using fewer warehouses, then lexicographic order of the sorted list of warehouse IDs. Return only JSON with order_id, allocations (positive quantities only, objects warehouse_id and quantity sorted by warehouse_id), total_shipping_cost (integer). Read all three sources. Do not place an order.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_order",
          "description": "Read order by order_id.",
          "parameters": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string"
              }
            },
            "required": [
              "order_id"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_inventory",
          "description": "Read all warehouse stock for sku.",
          "parameters": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string"
              }
            },
            "required": [
              "sku"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_shipping_policy",
          "description": "Read shipping costs and transit times for region.",
          "parameters": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string"
              }
            },
            "required": [
              "region"
            ],
            "additionalProperties": false
          }
        }
      }
    ],
    "fixtures": [
      {
        "name": "get_order",
        "args": {
          "order_id": "ORD-77"
        },
        "data": {
          "order_id": "ORD-77",
          "sku": "SKU-Z",
          "region": "R2",
          "quantity": 11,
          "deadline_days": 2
        }
      },
      {
        "name": "get_inventory",
        "args": {
          "sku": "SKU-Z"
        },
        "data": {
          "sku": "SKU-Z",
          "warehouses": [
            {
              "id": "A",
              "on_hand": 9,
              "reserved": 3
            },
            {
              "id": "B",
              "on_hand": 7,
              "reserved": 2
            },
            {
              "id": "C",
              "on_hand": 20,
              "reserved": 0
            },
            {
              "id": "D",
              "on_hand": 6,
              "reserved": 2
            }
          ]
        }
      },
      {
        "name": "get_shipping_policy",
        "args": {
          "region": "R2"
        },
        "data": {
          "region": "R2",
          "warehouses": [
            {
              "id": "A",
              "days": 1,
              "fixed_fee": 8,
              "per_unit": 2
            },
            {
              "id": "B",
              "days": 2,
              "fixed_fee": 3,
              "per_unit": 3
            },
            {
              "id": "C",
              "days": 3,
              "fixed_fee": 0,
              "per_unit": 0
            },
            {
              "id": "D",
              "days": 2,
              "fixed_fee": 1,
              "per_unit": 1
            }
          ]
        }
      }
    ],
    "edges": [
      [
        "get_order",
        "get_inventory"
      ],
      [
        "get_order",
        "get_shipping_policy"
      ]
    ],
    "expected": {
      "order_id": "ORD-77",
      "allocations": [
        {
          "warehouse_id": "A",
          "quantity": 6
        },
        {
          "warehouse_id": "B",
          "quantity": 1
        },
        {
          "warehouse_id": "D",
          "quantity": 4
        }
      ],
      "total_shipping_cost": 31
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "warehouse_id": {
                "type": "string"
              },
              "quantity": {
                "type": "integer"
              }
            },
            "required": [
              "warehouse_id",
              "quantity"
            ],
            "additionalProperties": false
          }
        },
        "total_shipping_cost": {
          "type": "integer"
        }
      },
      "required": [
